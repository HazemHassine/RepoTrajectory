GITHUB_TOKEN=github_pat_replace_me
DATABASE_URL=postgresql+asyncpg://github_analytics:github_analytics@localhost:15432/github_analytics
LOG_LEVEL=INFO
GITHUB_API_URL=https://api.github.com
DEV_POSTGRES_PORT=15432

# Local administration. Run ./run.sh admin-password; never place plaintext here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=8
ADMIN_SECURE_COOKIES=false

# GitHub REST safety and bounded hydration
GITHUB_REQUEST_INTERVAL_SECONDS=0.15
GITHUB_RATE_LIMIT_RESERVE=100
INGESTION_BOOTSTRAP_DAYS=180
INGESTION_RELEASE_DAYS=730
INGESTION_CONTRIBUTOR_LIMIT=200
INGESTION_COMMIT_LIMIT=5000
INGESTION_ISSUE_LIMIT=3000
INGESTION_PULL_REQUEST_LIMIT=3000
INGESTION_RELEASE_LIMIT=500

# Autonomous collection policy
COLLECTOR_ENABLED=true
COLLECTOR_POLL_SECONDS=10
COLLECTOR_LEASE_MINUTES=30
COLLECTOR_CANDIDATE_LIMIT=2000
COLLECTOR_ACTIVE_LIMIT=250
COLLECTOR_ACTIVE_REFRESH_HOURS=24
COLLECTOR_CANDIDATE_REFRESH_HOURS=168
DISCOVERY_LANGUAGES=Python,TypeScript,JavaScript,Go,Rust,Java
DISCOVERY_RESULTS_PER_LANGUAGE=200
DISCOVERY_MIN_STARS=500
DISCOVERY_PUSHED_WITHIN_DAYS=180
DISCOVERY_PROBE_LIMIT_PER_RECONCILE=50

# GH Archive is streamed and compacted; raw event payloads are never stored.
GH_ARCHIVE_ENABLED=true
GH_ARCHIVE_BASE_URL=https://data.gharchive.org
GH_ARCHIVE_ALGORITHM_VERSION=2
GH_ARCHIVE_HOURS_BACK=6
GH_ARCHIVE_LAG_HOURS=3
GH_ARCHIVE_TOP_REPOSITORIES_PER_HOUR=500
GH_ARCHIVE_RETENTION_DAYS=90

# AI Provider and Embeddings (supports Google Gemini / OpenAI)
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
GEMINI_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EVALUATION_MODEL=gemini-3.8-flash
AI_EMBEDDING_DIMENSION=1536
AI_REQUEST_TIMEOUT_SECONDS=30.0

# Canonical Directory and Diversity Limits
DIRECTORY_LIMIT=10000
DIRECTORY_LANGUAGE_CAP=0.25
CANDIDATE_POOL_LIMIT=50000
CANDIDATE_RETENTION_DAYS=90
DEEP_COHORT_LIMIT=500

# Search Parameters
SEARCH_RRF_K=60
SEARCH_SEMANTIC_WEIGHT=0.5
SEARCH_LEXICAL_WEIGHT=0.5

