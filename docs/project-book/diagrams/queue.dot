digraph G {
  graph [bgcolor="transparent", rankdir=LR, pad=.2, nodesep=.55, ranksep=.55];
  node [shape=ellipse, style="filled", fontname="Arial", fontsize=10, color="#384152", fillcolor="#151922", fontcolor="#f4f7fb", margin=".14,.09"];
  edge [color="#8ea0b5", fontcolor="#aebdcb", fontname="Arial", fontsize=8.5, arrowsize=.65];
  queued [label="QUEUED", fillcolor="#27301c", color="#a6d800"];
  running [label="RUNNING", fillcolor="#1f2937"];
  done [label="COMPLETED", fillcolor="#183024"];
  failed [label="FAILED", fillcolor="#351f24"];
  cancelled [label="CANCELLED", fillcolor="#302b1d"];
  queued -> running [label="claim due row\nFOR UPDATE SKIP LOCKED"];
  running -> done [label="commit success"];
  running -> queued [label="transient error / rate limit\nbackoff + scheduled_for"];
  running -> queued [label="lease expired / worker died"];
  running -> failed [label="terminal or attempts exhausted"];
  queued -> cancelled [label="admin conditional cancel"];
  failed -> queued [label="admin retry"];
  cancelled -> queued [label="admin retry"];
}
